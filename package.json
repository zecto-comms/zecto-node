{
  "name": "zecto",
  "version": "0.1.0",
  "description": "Official Node.js and TypeScript SDK for the Zecto WhatsApp Business messaging API",
  "keywords": [
    "zecto",
    "whatsapp",
    "whatsapp-api",
    "whatsapp-business",
    "messaging",
    "sdk"
  ],
  "homepage": "https://zecto.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zecto-comms/zecto-node.git"
  },
  "bugs": {
    "url": "https://github.com/zecto-comms/zecto-node/issues"
  },
  "author": "Zecto",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "tsup": "^8.5.1",
    "typescript": "^5.6.0"
  },
  "sideEffects": false
}
